# Desarrollo local
APP_ENV=development
API_BASE_URL=http://127.0.0.1:8787
JAH_AI_HOST=127.0.0.1
JAH_AI_PORT=8787
JAH_AI_LOG_LEVEL=INFO

TUTOR_IA_ROOT=/home/abraham/Documentos/tutor_ia
TUTOR_IA_PERSIST_DIR=/home/abraham/Documentos/tutor_ia/vectores/brain_db
TUTOR_IA_RAG_PERSIST_DIR=/home/abraham/Documentos/tutor_ia/vectores/jah_ai_rag
TUTOR_IA_KNOWLEDGE_DIR=/home/abraham/Documentos/tutor_ia/conocimiento
JAH_AI_UPLOAD_DIR=/home/abraham/Documentos/tutor_ia/conocimiento/_uploads

# Produccion Railway. Crea estas variables en Railway, no en un .env subido.
# APP_ENV=production
# TUTOR_IA_ROOT=/app/tutor_ia
# TUTOR_IA_PERSIST_DIR=/app/tutor_ia/vectores/brain_db
# TUTOR_IA_RAG_PERSIST_DIR=/app/tutor_ia/vectores/jah_ai_rag
# TUTOR_IA_KNOWLEDGE_DIR=/app/tutor_ia/conocimiento
# JAH_AI_UPLOAD_DIR=/app/tutor_ia/conocimiento/_uploads

JAH_AI_RAG_COLLECTION=jah_ai_rag
JAH_AI_EMBEDDING_BACKEND=auto
JAH_AI_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
TUTOR_IA_EMBED_DIM=384
JAH_AI_RETRIEVE_CANDIDATES=8
JAH_AI_RESPONSE_TOP_K=4
JAH_AI_CHUNK_SIZE=1200
JAH_AI_CHUNK_OVERLAP=180
JAH_AI_MIN_RELEVANCE_SCORE=0.18
RAG_SCORE_THRESHOLD=0.72
RAG_TOP_K=5
RAG_MIN_RELEVANT_CHUNKS=1
RAG_MAX_CONTEXT_CHUNKS=5
TUTOR_IA_SCORE_THRESHOLD=0.72
OBSIDIAN_SCORE_THRESHOLD=0.78
OFFICIAL_SOURCES_SCORE_THRESHOLD=0.80

JAH_AI_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434
JAH_AI_OLLAMA_TIMEOUT_SECONDS=45
JAH_AI_OLLAMA_NUM_CTX=4096
JAH_AI_OLLAMA_NUM_PREDICT=900
JAH_AI_OLLAMA_TEMPERATURE=0.2

WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=12

JAH_AI_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5500,http://127.0.0.1:5500,https://jhernandez30-cpu.github.io
# Alias compatible con plataformas de despliegue. JAH_AI_ALLOWED_ORIGINS tiene prioridad.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5500,http://127.0.0.1:5500,https://jhernandez30-cpu.github.io
JAH_AI_ALLOWED_ORIGIN_REGEX=^https://jhernandez30-cpu\.github\.io$|^http://(localhost|127\.0\.0\.1)(:\d+)?$

# Autenticacion y sesiones. No pongas secretos reales en este archivo.
# Usa AUTH_PROVIDER=local para desarrollo sin Supabase.
# Usa AUTH_PROVIDER=supabase en Railway cuando Supabase Auth este configurado.
AUTH_PROVIDER=local
AUTH_FRONTEND_URL=http://127.0.0.1:5500/asistente-programacion.html
# FRONTEND_URL es un alias util en Railway; AUTH_FRONTEND_URL tiene prioridad.
FRONTEND_URL=http://127.0.0.1:5500/asistente-programacion.html
AUTH_SESSION_TTL_HOURS=168
AUTH_ALLOW_FILE_RETURN=true
OWNER_EMAIL=
ADMIN_EMAILS=

# Supabase Auth y PostgreSQL. La anon key es publica; service role y DATABASE_URL son solo backend/Railway.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GOOGLE_ENABLED=false
SUPABASE_APPLE_ENABLED=false
DATABASE_URL=
POSTGRES_CONNECT_TIMEOUT_SECONDS=8

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback
GOOGLE_OAUTH_SCOPE=openid email profile

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/apple/callback
APPLE_OAUTH_SCOPE=name email

SQLSERVER_ENABLED=false
SQLSERVER_HOST=
SQLSERVER_PORT=
SQLSERVER_DATABASE=TUTORIA
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_TRUSTED_CONNECTION=true
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_POOLING=false
SQLSERVER_APPLICATION_NAME=JAH AI Bridge Auth
SQLSERVER_CONNECT_TIMEOUT_SECONDS=5
SQLSERVER_QUERY_TIMEOUT_SECONDS=10
