TUTOR_IA_DB_PATH=./tutor_ia.db

# SQL Server / SSMS 22 - base activa TUTORIA
# Para instancia nombrada como localhost\SQLEXPRESS, deja SQLSERVER_PORT vacio.
SQLSERVER_ENABLED=true
SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_PORT=
SQLSERVER_DATABASE=TUTORIA
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_TRUSTED_CONNECTION=true
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_POOLING=false
SQLSERVER_APPLICATION_NAME="ULTRON tutor_ia integration"
SQLSERVER_CONNECT_TIMEOUT_SECONDS=5
SQLSERVER_QUERY_TIMEOUT_SECONDS=10
SQLSERVER_MAX_RETRIES=3
SQLSERVER_BACKOFF_SECONDS=1.5

# Orquestacion RAG contextual
RAG_SCORE_THRESHOLD=0.72
RAG_TOP_K=5
RAG_MIN_RELEVANT_CHUNKS=1
RAG_MAX_CONTEXT_CHUNKS=5
TUTOR_IA_SCORE_THRESHOLD=0.72
OBSIDIAN_SCORE_THRESHOLD=0.78
OFFICIAL_SOURCES_SCORE_THRESHOLD=0.80

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8502
GOOGLE_OAUTH_SCOPE=openid email profile

TUTOR_IA_ROOT=C:\ruta\a\tutor_ia
TUTOR_IA_PERSIST_DIR=C:\ruta\a\tutor_ia\brain_db
TUTOR_IA_OBSIDIAN_DIR=C:\ruta\a\tutor_ia\Tutor_IA
TUTOR_IA_OBSIDIAN_ENABLED=1

TUTOR_IA_WEB_HOST=127.0.0.1
TUTOR_IA_WEB_PORT=8787
TUTOR_IA_STREAMLIT_RESPONSE_PROFILE=web_fast
TUTOR_IA_RECENT_HISTORY_LIMIT=6

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

BRIDGE_API_URL=http://127.0.0.1:8787
BRAIN_TIMEOUT_SECONDS=8
BRIDGE_TIMEOUT_SECONDS=10
MAX_CONTEXT_CHARS=12000
